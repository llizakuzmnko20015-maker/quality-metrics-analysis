        }

        // ОШИБКА 8: Метод с высокой цикломатической сложностью
        public string GetGrade(double score)
        {
            // ОШИБКА 9: Нет проверки на выход за границы (score может быть >100 или <0)
            if (score >= 90)
                return "Отлично";
            if (score >= 75)
                return "Хорошо";
            if (score >= 50)
                return "Удовлетворительно";
            if (score >= 25)
                return "Плохо";
            if (score >= 10)
                return "Очень плохо";
            // ОШИБКА 10: Нет обработки случая score < 10 (вернется null)
            return null;
        }

        // ОШИБКА 11: Глубокая вложенность (цикломатическая сложность)
        public double CalculateDiscount(double price, int customerLevel, bool isHoliday, bool isWeekend, bool isMember)
        {
            double discount = 0;

            if (customerLevel >= 5)
            {
                if (isHoliday)
                {
                    if (isMember)
                    {
                        discount = 0.35;
                    }
                    else
                    {
                        discount = 0.30;
                    }
                }
                else
                {
                    if (isWeekend)
                    {
                        if (isMember)
                        {
                            discount = 0.25;
                        }
                        else
                        {
                            discount = 0.20;
                        }
                    }
                    else
                    {
                        discount = 0.15;
                    }
                }
            }
            else
            {
                if (isHoliday)
                {
                    if (isMember)
                    {
                        discount = 0.15;
                    }
                    else
                    {
                        discount = 0.10;
                    }
                }
                else
                {
                    discount = 0.05;
                }
            }

            // ОШИБКА 12: Нет проверки, что discount не превышает 100%
            return price * discount;
        }

        // ОШИБКА 13: Метод с пустым catch
        public double SafeDivide(double a, double b)
        {
            try
            {
                return a / b;
            }
            catch
            {
                // ОШИБКА 14: Пустой блок catch - подавление исключений
                // ОШИБКА 15: Не возвращается значение в случае ошибки
            }
            // ОШИБКА 16: Компилятор выдаст предупреждение о недостижимом коде
            return 0;
        }

        // ОШИБКА 17: Имя метода не соответствует рекомендациям (должно быть с большой буквы)
        public void calculateAverage(List<double> numbers)
        {
            // ОШИБКА 18: Нет проверки на null
            // ОШИБКА 19: Нет проверки на пустой список
            double sum = 0;
            foreach (var num in numbers)
                sum += num;
            // ОШИБКА 20: Переменная не используется
            double avg = sum / numbers.Count;
            // ОШИБКА 21: Не сохраняется результат
        }

        // ОШИБКА 22: Дублирование кода (почти идентично методу CalculateDiscount)
        public double GetFinalPrice(double basePrice, int level, bool holiday, bool weekend, bool member)
        {
            double discount = 0;

            if (level >= 5)
            {
                if (holiday)
                {
                    if (member)
                    {
                        discount = 0.35;
                    }
                    else
                    {
                        discount = 0.30;
                    }
                }
                else
                {
                    if (weekend)
                    {
                        if (member)
                        {
                            discount = 0.25;
                        }
                        else
                        {
                            discount = 0.20;
                        }
                    }
                    else
                    {
                        discount = 0.15;
                    }
                }
            }
            else
            {
                if (holiday)
                {
                    if (member)
                    {
                        discount = 0.15;
                    }
                    else
                    {
                        discount = 0.10;
                    }
                }
                else
                {
                    discount = 0.05;
                }
            }

            return basePrice * discount;
        }

        // ОШИБКА 23: Неиспользуемый метод
        private void UnusedMethod()
