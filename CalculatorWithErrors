        // ОШИБКА 3: Конструктор не инициализирует _history

        // === Базовые операции ===

        public double Add(double a, double b)
        {
            // ОШИБКА 4: Нет проверки на переполнение
            double result = a + b;
            _lastResult = result;
            // ОШИБКА 5: NullReferenceException (history не инициализирован)
            _history.Add(result);
            return result;
        }

        public double Subtract(double a, double b)
        {
            double result = a - b;
            _lastResult = result;
            _history.Add(result);
            return result;
        }

        public double Multiply(double a, double b)
        {
            double result = a * b;
            _lastResult = result;
            _history.Add(result);
            return result;
        }

        // ОШИБКА 6: Деление на ноль не обрабатывается
