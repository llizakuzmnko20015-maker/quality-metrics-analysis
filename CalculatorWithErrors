            Console.WriteLine("Этот метод никогда не вызывается");
        }

        // ОШИБКА 24: Использование магических чисел
        public bool IsValidAge(int age)
        {
            return age >= 18 && age <= 65;
            // Должно быть: const int MIN_AGE = 18; const int MAX_AGE = 65;
        }

        // ОШИБКА 25: Метод слишком длинный (более 20 строк)
