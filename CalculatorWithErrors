        }

        // ОШИБКА 29: Неасинхронный метод, но с Async в имени
        public async void GetDataAsync()
        {
            // async void опасен для использования - ошибки не обрабатываются
            // и сложно отследить завершение
        }

        // ОШИБКА 30: Проверка на null через ReferenceEquals (неправильно)
        public bool IsNull(object obj)
        {
            return ReferenceEquals(obj, null);
            // Лучше: return obj == null;
        }
    }

    // ОШИБКА 31: Класс не следует рекомендациям по именованию (должен быть Order)
    public class order
    {
        public int Id { get; set; }
        public double Amount { get; set; }
        public bool IsValid { get; set; }
    }

    // ОШИБКА 32: Интерфейс без префикса I
    public interface Calculable
    {
        double Compute();
    }

    // ОШИБКА 33: Реализация интерфейса без префикса
